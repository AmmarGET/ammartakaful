{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ammartraveldraft",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/auth", "/callback"]
  }
}
