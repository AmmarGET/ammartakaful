---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { site, wa, abs, fmtDate, readingMinutes, getArticles } from '../../lib';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map(entry => ({ params: { slug: entry.id }, props: { entry, others: articles.filter(a => a.id !== entry.id).slice(0, 3) } }));
}

const { entry, others } = Astro.props;
const { title, description, date, cover, coverAlt, tags } = entry.data;
const { Content } = await render(entry);
const path = `/artikel/${entry.id}/`;
const iso = date.toISOString().slice(0, 10);
const image = cover || site.seo.ogImage;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: iso,
    dateModified: iso,
    image: [abs(image)],
    inLanguage: 'ms-MY',
    mainEntityOfPage: abs(path),
    author: { '@type': 'Person', name: site.name },
    publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: abs('/icons/icon-512.png') } }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Utama', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Artikel', item: abs('/artikel/') },
      { '@type': 'ListItem', position: 3, name: title, item: abs(path) }
    ]
  }
];
const mins = readingMinutes(entry.body ?? '');
---
<Base title={`${title} | ${site.name}`} description={description} path={path} ogImage={image} type="article" publishedTime={iso} jsonLd={jsonLd}>
  <article class="post">
    <header class="page-head dark">
      <div class="wrap narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Utama</a> / <a href="/artikel/">Artikel</a></nav>
        <h1>{title}</h1>
        <p class="meta"><time datetime={iso}>{fmtDate(date)}</time> · {mins} minit bacaan · oleh {site.name}</p>
      </div>
    </header>
    <div class="wrap narrow">
      {cover && <img class="post-cover" src={cover} alt={coverAlt || title} width="1200" height="675" fetchpriority="high">}
      <div class="prose"><Content /></div>
      {tags.length > 0 && <ul class="tags">{tags.map(t => <li>{t}</li>)}</ul>}
      <aside class="post-cta">
        <div>
          <h2>Nak semak harga untuk trip anda?</h2>
          <p>Isi destinasi dan tarikh, harga semua plan keluar serta-merta.</p>
        </div>
        <div class="cta-row">
          <a class="btn btn-y" href="/#semak-harga">Semak Harga <svg class="ic"><use href="#i-arrow"/></svg></a>
          <a class="btn btn-k" href={wa()} data-wa={site.defaultMessage} target="_blank" rel="noopener"><svg class="ic fill"><use href="#i-wa"/></svg>WhatsApp {site.shortName}</a>
        </div>
      </aside>
    </div>
  </article>
  {others.length > 0 && (
    <section class="sec soft">
      <div class="wrap">
        <h2 class="mini">Baca juga</h2>
        <div class="art-grid" data-alt>{others.map(a => <ArticleCard entry={a} />)}</div>
      </div>
    </section>
  )}
</Base>
